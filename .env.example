# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# DEMO=true simulates payment without calling Safaricom.
DEMO=true

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/promise_enterprise

# Safaricom Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://YOUR-PUBLIC-DOMAIN/api/payment/callback

# Optional: override these if Safaricom changes endpoint URLs.
MPESA_OAUTH_URL=https://sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
MPESA_STK_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest

# Wi-Fi integration
WIFI_MODE=demo
